@testlib.skipBeiboot("host switching disabled in beiboot mode")
class TestShutdownRestart(testlib.MachineCase):
    provision = {
        "machine1": {"address": "10.111.113.1/20"},
        "machine2": {"address": "10.111.113.2/20"}
    }

    def setUp(self):
        super().setUp()
        self.setup_provisioned_hosts()

    def testBasic(self):
        m = self.machine
        b = self.browser

        m2 = self.machines['machine2']
        b2 = self.new_browser(m2)

        # Disable pre-loading packagekit, dnf needs-restarting (dnf 4) consumes tons of cpu/memory on RHEL-10-1
        self.disable_preload("packagekit")
        self.disable_preload("packagekit", machine=m2)

        self.enable_multihost(m2)

        m.start_cockpit()

        self.login_and_go("/system")

        # Reboot
        b.click("#reboot-button")
        b.wait_popup("shutdown-dialog")
        b.wait_in_text(f"#shutdown-dialog button{self.danger_btn_class}", 'Reboot')
        b.set_input_text("#message", "Rebooting for maintenance")
        b.click("#delay")
        b.click("button:contains('No delay')")
        b.wait_text("#delay .pf-v6-c-menu-toggle__text", "No delay")
        b.click(f"#shutdown-dialog button{self.danger_btn_class}")
        b.switch_to_top()

        b.wait_in_text(".curtains-ct h1", "Disconnected")

        self.wait_reboot()
        m.start_cockpit()
        b.click("#machine-reconnect")
        b.wait_visible("#login")

        self.allow_journal_messages("Shutdown scheduled for .*")
        self.check_journal_messages()

        m2.start_cockpit()
        b2.login_and_go("/system")

        # Add machine with static IP to m2
        b2.add_machine("10.111.113.1")
        b2.wait_text("#system_information_hostname_text", "machine1")

        # Check auto reconnect on reboot
        b2.become_superuser()
        b2.click("#reboot-button")
        b2.wait_popup("shutdown-dialog")
        b2.wait_in_text(f"#shutdown-dialog button{self.danger_btn_class}", 'Reboot')
        b2.click("#delay")
        b2.click("button:contains('No delay')")
        b2.wait_text("#delay .pf-v6-c-menu-toggle__text", "No delay")
        b2.click(f"#shutdown-dialog button{self.danger_btn_class}")
        b2.switch_to_top()

        b2.wait_visible(".curtains-ct")
        b2.wait_visible(".curtains-ct .pf-v6-c-spinner")
        b2.wait_in_text(".curtains-ct h1", "rebooting")

        self.wait_reboot()

        with b2.wait_timeout(30):
            b2.wait_visible("#machine-troubleshoot")
        b2.start_machine_troubleshoot(password="foobar", expect_warning=False)

        b2.enter_page("/system", host="10.111.113.1", reconnect=False)

        # Try to insert an invalid time
        self.login_and_go("/system")
        b.enter_page("/system")
        b.click("#shutdown-group")  # caret
        b.click("#shutdown")
        b.wait_popup("shutdown-dialog")
        b.wait_not_present("#delay-helper")
        b.click("#delay")
        b.click("button:contains('Specific time')")
        b.wait_text("#delay .pf-v6-c-menu-toggle__text", "Specific time")
        b.wait_not_val("#shutdown-time-input", "")
        b.wait_not_present("#delay-helper")
        old = b.val("#shutdown-time-input")
        b.set_input_text("#shutdown-time-input", "blah")
        b.wait_text("#delay-helper", "Invalid time format")
        b.wait_visible(f"#shutdown-dialog button{self.danger_btn_class}:disabled")

        # Now set a correct time
        b.set_input_text("#shutdown-time-input", old)
        b.wait_visible(f"#shutdown-dialog button{self.danger_btn_class}:not(disabled)")
        b.wait_not_present("#delay-helper")

        # Try to insert an invalid date
        old_date = b.val(".shutdown-date-picker input")
        b.set_input_text(".shutdown-date-picker input", "20/0x/2021")
        b.wait_val(".shutdown-date-picker input", "20/0x/2021")
        b.wait_text("#delay-helper", "Invalid date format")
        b.wait_visible(f"#shutdown-dialog button{self.danger_btn_class}:disabled")

        # Restore the valid date before opening the picker, to avoid
        # https://github.com/cockpit-project/cockpit/issues/23205
        b.set_input_text(".shutdown-date-picker input", old_date)
        b.wait_not_present("#delay-helper")

        # Insert a date using the widget dropdown
        b.click("button[aria-label='Toggle date picker']")
        today_label = m.execute("date +'%-d %B %Y'").strip()
        today_format = m.execute("date +'%Y-%m-%d'").strip()
        b.click(f".pf-v6-c-calendar-month__dates-cell:not(.pf-m-adjacent-month) button[aria-label='{today_label}']")
        b.wait_val(".shutdown-date-picker input", today_format)
        b.blur(".shutdown-date-picker input")

        # Power off
        b.click(f"#shutdown-dialog button{self.danger_btn_class}")
        b.switch_to_top()

        # we don't need to wait for the dialog to close here, just the disconnect
        b.wait_in_text(".curtains-ct h1", "Disconnected")

        m.wait_poweroff()


class TestSuspendDialog(testlib.MachineCase):

    @testlib.nondestructive
    def testSuspendNotSupported(self):
        m = self.machine
        b = self.browser

        # Mock absence of kernel suspend support by masking /sys/power/state
        m.execute("mount -t tmpfs none /sys/power")
        self.addCleanup(m.execute, "! mountpoint -q /sys/power || umount /sys/power")

        self.login_and_go("/system")

        # Open the dropdown and verify Suspend option is absent
        b.click("#shutdown-group")  # caret
        b.wait_not_present("#suspend")

        # Restore /sys/power
        m.execute("umount /sys/power")
        b.reload()
        b.enter_page("/system")
        b.click("#shutdown-group")
        b.wait_visible("#suspend")

    @testlib.nondestructive
    def testSuspendDialogBasic(self):
        m = self.machine
        b = self.browser

        # Mock systemctl suspend to prevent actual suspend in test
        self.restore_dir("/usr/local/bin")
        m.write("/usr/local/bin/systemctl",
                "#!/bin/sh\nif [ \"$1\" = 'suspend' ]; then echo 'suspend-mocked'; exit 0; fi\nexec /usr/bin/systemctl \"$@\"\n")
        m.execute("chmod +x /usr/local/bin/systemctl")

        self.login_and_go("/system")

        # Open the dropdown and click Suspend
        b.click("#shutdown-group")  # caret
        b.click("#suspend")
        b.wait_popup("shutdown-dialog")

        # Check dialog title
        b.wait_in_text("#shutdown-dialog .pf-v6-c-modal-box__title-text", "Suspend to RAM")

        # Check the submit button text
        b.wait_in_text(f"#shutdown-dialog button{self.danger_btn_class}", "Suspend")

        # Verify message field is hidden for suspend operations
        b.wait_not_present("#message")

        # Check delay options work
        b.click("#delay")
        b.click("#delay-5")
        b.wait_not_present("#delay-5")

        # Cancel the dialog
        b.click("#shutdown-dialog button.pf-m-link")
        b.wait_not_present("#shutdown-dialog")

    @testlib.nondestructive
    def testSuspendDelayed(self):
        m = self.machine
        b = self.browser

        # Mock systemctl suspend to prevent actual suspend
        self.restore_dir("/usr/local/bin")
        m.write("/usr/local/bin/systemctl",
                "#!/bin/sh\nif [ \"$1\" = 'suspend' ]; then echo 'suspend-mocked'; exit 0; fi\nexec /usr/bin/systemctl \"$@\"\n")
        m.execute("chmod +x /usr/local/bin/systemctl")

        self.login_and_go("/system")

        # Open suspend dialog with a delay
        b.click("#shutdown-group")  # caret
        b.click("#suspend")
        b.wait_popup("shutdown-dialog")

        # Select 5 minutes delay
        b.click("#delay")
        b.click("#delay-5")
        b.wait_not_present("#delay-5")

        # Submit
        b.click(f"#shutdown-dialog button{self.danger_btn_class}")
        b.wait_not_present("#shutdown-dialog")

        # Verify systemd-run created the timer
        timer_active = m.execute("systemctl is-active cockpit-suspend.timer 2>/dev/null || echo inactive").strip()
        self.assertEqual(timer_active, "active")

        # Clean up
        m.execute("systemctl stop cockpit-suspend.timer 2>/dev/null || true")

    @testlib.nondestructive
    def testSuspendWithWakeTime(self):
        m = self.machine
        b = self.browser

        if m.execute("test -f /sys/class/rtc/rtc0/wakealarm", check=False)[0] != 0:
            self.skipTest("RTC wake alarm is not supported on this system")

        # Mock systemctl suspend to prevent actual suspend
        self.restore_dir("/usr/local/bin")
        m.write("/usr/local/bin/systemctl",
                "#!/bin/sh\nif [ \"$1\" = 'suspend' ]; then echo 'suspend-mocked' >> /tmp/suspend.log; exit 0; fi\nexec /usr/bin/systemctl \"$@\"\n")
        m.execute("chmod +x /usr/local/bin/systemctl")
        self.addCleanup(m.execute, "rm -f /tmp/suspend.log")
        self.addCleanup(m.execute, "echo 0 > /sys/class/rtc/rtc0/wakealarm 2>/dev/null || true")

        self.login_and_go("/system")

        # Open suspend dialog
        b.click("#shutdown-group")  # caret
        b.click("#suspend")
        b.wait_popup("shutdown-dialog")

        # Verify wake-up time toggle exists and is off by default
        b.wait_visible("#wake-up-toggle")
        b.wait_visible("#wake-up-toggle:not(:checked)")

        # Enable wake-up time toggle
        b.click("#wake-up-toggle")

        # Wait for the wake date/time pickers to appear
        b.wait_visible("#wake-time-input")

        # Set a wake-up time 30 minutes in the future
        # Get current time + 30 min from the server
        wake_time = m.execute("date -d '+30 minutes' '+%H:%M'").strip()

        # Set the wake time
        b.set_input_text("#wake-time-input", wake_time)

        # Select "No delay"
        b.click("#delay")
        b.click("#delay-0")
        b.wait_not_present("#delay-0")

        # Submit — RTC wake alarm and systemctl suspend should be called
        b.click(f"#shutdown-dialog button{self.danger_btn_class}")
        b.wait_not_present("#shutdown-dialog")

        # Verify systemctl suspend was invoked
        suspend_log = m.execute("cat /tmp/suspend.log").strip()
        self.assertIn("suspend-mocked", suspend_log)

        # Verify RTC wake alarm was set
        wakealarm = m.execute("cat /sys/class/rtc/rtc0/wakealarm").strip()
        self.assertTrue(wakealarm and int(wakealarm) > 0)

    @testlib.nondestructive
    def testSuspendWithWakeTimeCancel(self):
        m = self.machine
        b = self.browser

        if m.execute("test -f /sys/class/rtc/rtc0/wakealarm", check=False)[0] != 0:
            self.skipTest("RTC wake alarm is not supported on this system")

        # Mock systemctl
        self.restore_dir("/usr/local/bin")
        m.write("/usr/local/bin/systemctl",
                "#!/bin/sh\nif [ \"$1\" = 'suspend' ]; then echo 'suspend-mocked' >> /tmp/suspend.log; exit 0; fi\nexec /usr/bin/systemctl \"$@\"\n")
        m.execute("chmod +x /usr/local/bin/systemctl")
        self.addCleanup(m.execute, "rm -f /tmp/suspend.log")

        # Ensure wakealarm is cleared initially
        m.execute("echo 0 > /sys/class/rtc/rtc0/wakealarm 2>/dev/null || true")

        self.login_and_go("/system")

        # Open suspend dialog
        b.click("#shutdown-group")  # caret
        b.click("#suspend")
        b.wait_popup("shutdown-dialog")

        # Enable wake-up time toggle
        b.click("#wake-up-toggle")
        b.wait_visible("#wake-time-input")

        # Cancel the dialog
        b.click("#shutdown-dialog button.pf-m-link")
        b.wait_not_present("#shutdown-dialog")

        # suspend should NOT have been called
        self.assertIn("No such file", m.execute("cat /tmp/suspend.log 2>&1 || true"))

    @testlib.nondestructive
    def testWakeTimeNotSupported(self):
        m = self.machine
        b = self.browser

        # Mock absence of RTC wakealarm by masking /sys/class/rtc
        m.execute("mount -t tmpfs none /sys/class/rtc 2>/dev/null || true")
        self.addCleanup(m.execute, "! mountpoint -q /sys/class/rtc || umount /sys/class/rtc")

        self.login_and_go("/system")

        # Open suspend dialog
        b.click("#shutdown-group")  # caret
        b.click("#suspend")
        b.wait_popup("shutdown-dialog")

        # Verify wake-up time toggle is absent when not supported
        b.wait_not_present("#wake-up-toggle")


class TestUncleanShutdownStatus(testlib.MachineCase):

    def _cleanReboot(self):
        m = self.machine
        b = self.browser
        b.click("#reboot-button")
        b.wait_popup("shutdown-dialog")
        b.wait_in_text(f"#shutdown-dialog button{self.danger_btn_class}", 'Reboot')
        b.set_input_text("#message", "Rebooting for maintenance")
        b.click("#delay")
        b.click("button:contains('No delay')")
        b.wait_text("#delay .pf-v6-c-menu-toggle__text", "No delay")
        b.click(f"#shutdown-dialog button{self.danger_btn_class}")

        b.switch_to_top()
        b.wait_in_text(".curtains-ct h1", "Disconnected")

        self.wait_reboot()
        m.start_cockpit()
        b.click("#machine-reconnect")
        b.wait_visible("#login")
        self.login_and_go("/system")

    def _uncleanReboot(self):
        m = self.machine
        b = self.browser
        m.spawn("reboot -f", "reboot")

        b.switch_to_top()
        with b.wait_timeout(30):
            b.wait_in_text(".curtains-ct h1", "Disconnected")

        self.wait_reboot()
        m.start_cockpit()
        b.click("#machine-reconnect")
        b.wait_visible("#login")
        self.login_and_go("/system")

    def testBasic(self):
        m = self.machine
        b = self.browser

        # Disable pre-loading packagekit, dnf needs-restarting (dnf 4) consumes tons of cpu/memory on RHEL-10-1
        self.disable_preload("packagekit")

        m.start_cockpit()
        self.login_and_go("/system")
        b.wait_visible('#system_information_os_text')
        b.wait_not_present("#unclean-shutdown-status")

        # Unclean reboot
        self._uncleanReboot()
        b.wait_visible("#unclean-shutdown-status")
        b.wait_in_text("#unclean-shutdown-status", "Unclean shutdown")

        # Link to logs page
        b.click("#unclean-shutdown-status button:contains('View logs')")
        b.switch_to_top()
        b.wait_js_cond('window.location.pathname == "/system/logs"')
        b.wait_js_cond('window.location.hash == "#/?boot=-1"')

        # Dismiss
        b.go("/system")
        b.enter_page("/system")
        b.click("#unclean-shutdown-status-dismiss")
        b.wait_not_present("#unclean-shutdown-status")

        # Clean reboot
        self._cleanReboot()
        b.wait_not_present("#unclean-shutdown-status")


if __name__ == '__main__':
    testlib.test_main()
